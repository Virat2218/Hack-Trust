# TrustShield AI Environment Configuration
# All external API keys are strictly optional.
# If keys are omitted, TrustShield AI operates cleanly and honestly using local heuristic engines.

PORT=8000
HOST=127.0.0.1

# Optional: Google Safe Browsing API v4 Key (for external URL reputation)
SAFE_BROWSING_API_KEY=

# Optional: Google Fact Check Tools API Key (for external claim verification)
FACT_CHECK_API_KEY=

# Optional: Comma-separated list of additional allowed CORS origins (e.g. https://my-domain.com)
ALLOWED_ORIGINS=

